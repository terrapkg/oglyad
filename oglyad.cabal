cabal-version:   3.0
name:            oglyad
version:         0.1.0.0
synopsis:        repository metadata and health checker for Terra
description:
  oglyad checks a terrapkg/packages checkout against Terra's published
  repodata and upstream releases. it reports packages that never got built,
  stale builds, upstream version drift, broken update.rhai scripts, and
  overlap with Fedora.

category:        Distribution
homepage:        https://github.com/halfcyan/oglyad
bug-reports:     https://github.com/halfcyan/oglyad/issues
license:         GPL-3.0-or-later
license-file:    LICENSE
author:          Cypress Reed
maintainer:      cypress@fyralabs.com
build-type:      Simple
extra-doc-files: README.md

source-repository head
  type:     git
  location: https://github.com/halfcyan/oglyad.git

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DeriveAnyClass
    LambdaCase
    MultiWayIf
    OverloadedStrings
    RecordWildCards

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints

  build-depends:
    , base        >=4.18 && <5
    , containers
    , deepseq
    , text
    , time

-- the modules shared by the binary and the test suite. there's deliberately
-- no library: packaged with Fedora's ghc-rpm-macros, an internal library
-- turns into a private .so that also links the test suite's dependencies
common modules
  hs-source-dirs:  src
  other-modules:
    Oglyad.App
    Oglyad.Check
    Oglyad.Check.BuildLag
    Oglyad.Check.Drift
    Oglyad.Check.DuplicateName
    Oglyad.Check.FedoraOverlap
    Oglyad.Check.NoAutoupdate
    Oglyad.Check.Stale
    Oglyad.Check.UnparsedRhai
    Oglyad.Check.UpstreamError
    Oglyad.Collect
    Oglyad.Ignore
    Oglyad.Process
    Oglyad.Report
    Oglyad.Source.Cache
    Oglyad.Source.Monorepo
    Oglyad.Source.Repodata
    Oglyad.Source.Rhai
    Oglyad.Source.Upstream
    Oglyad.Types
    Oglyad.Version
    Paths_oglyad

  autogen-modules: Paths_oglyad
  build-depends:
    , aeson
    , async
    , base16-bytestring
    , bytestring
    , conduit
    , cryptohash-sha256
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , megaparsec
    , mtl
    , typed-process
    , vector
    , xml-conduit
    , xml-types

executable oglyad
  import:         shared, modules
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N4"
  build-depends:  optparse-applicative

test-suite oglyad-test
  import:         shared, modules
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded
  build-depends:
    , hspec
    , QuickCheck
    , temporary
